# Browser caching for static assets - previously every CSS/JS/image response came back
# Cache-Control: private with no max-age (confirmed live 2026-08-31), so browsers re-fetched
# or at minimum revalidated every one of them on every single page load, even for a
# returning visitor with nothing changed. Deliberately does NOT touch .php files or
# extension-less requests - those all still hit dynamic PHP/API responses, which this must
# never cache (see ga_maybe_show_roadblock_ad()'s cookie-gated redirect and the roadblock/
# interstitial ad logic, which would break if a page response got cached and reused across
# visitors).
#
# Images/fonts: truly static, essentially-immutable assets (logo, ad fallback images, any
# local fonts) - a full year is safe since they're the kind of file that gets replaced with a
# new filename when it changes, not edited in place.
#
# CSS/JS: only the first-party GreatAndhra files (see ga_asset_version() in inc/helpers.php)
# get a cache-busting content-hash query param that guarantees a changed file is fetched
# fresh even under long caching - the many third-party/vendor scripts on this site
# (jQuery and its plugins, ad-network SDKs, etc.) have NOT been through that yet, so this
# stays at a bounded 1-week window rather than a full year, to cap how stale any of those
# could ever get in the meantime. Revisit once those get their own versioning pass.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteBase /

# Canonicalize old inner-page.php/{id}/... links to the new bare form. Matched against
# THE_REQUEST (the original request line as the browser sent it) rather than the current
# rewritten URI — THE_REQUEST never changes across internal rewrite passes, so this rule
# does NOT re-fire when the bare-URL rule below internally rewrites a request back to
# inner-page.php/... on the same pass. Matching on the live URI instead would loop forever:
# bare -> internal rewrite to inner-page.php/... -> (re-matches this rule) -> redirect back
# to bare -> browser re-requests bare -> repeat.
RewriteCond %{THE_REQUEST} \s/inner-page\.php/([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})(/[^\s]*)?\s
RewriteRule ^ /%1%2 [R=301,L]

# Same THE_REQUEST-matched canonicalization for the old box-office.php link -> /box-office.
# Query string (?page=2) is captured and carried over if present.
RewriteCond %{THE_REQUEST} \s/box-office\.php(\?[^\s]*)?\s
RewriteRule ^ /box-office%1 [R=301,L]

# Real files and directories (css/, js/, images/, assets/, cache/, inc/, the other .php
# entry points, favicon.ico, etc.) pass straight through — untouched. This is what keeps
# a bare-URL rewrite below from swallowing asset requests and breaking the whole page.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Bare article URLs: /{id}/{category}/{subcategory?}/{title-slug}, where {id} is either
# the numeric shortId or a full UUID. Internally forwarded to inner-page.php with the same
# PATH_INFO shape it already parses today (see inner-page.php's PATH_INFO handling) — the
# browser URL bar stays clean, but Apache still runs the exact same script/PATH_INFO combo
# as the current inner-page.php/{id}/... links, so inner-page.php itself needs no changes.
# Old inner-page.php/{id}/... links still work as-is (untouched by this rule, matched above).
RewriteRule ^([0-9]+|[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})(/.*)?$ inner-page.php/$1$2 [L]

# Bare /box-office -> box-office.php. Must come before the generic category/tag catch-all
# below so this specific, single-purpose page claims the path first.
RewriteRule ^box-office/?$ box-office.php [L]

# Everything else that's 1-3 dot-free path segments (category paths like movies/gossip,
# politics/andhra, politics; or tag/{tagId}/{slug}) is forwarded to list-page.php, which
# resolves the path itself (GA_CATEGORY_ROUTES, or the literal "tag/" prefix) and 404s for
# anything it doesn't recognize. Deliberately generic and excludes dots — this is what keeps
# it from needing an .htaccess edit every time a category is added, and from ever matching a
# real dotted filename (favicon.ico, robots.txt, etc.) that simply doesn't exist yet.
# Numeric/UUID article paths are already claimed by the rule above and never reach this one.
RewriteRule ^([A-Za-z0-9-]+)(/[A-Za-z0-9-]+)?(/[A-Za-z0-9-]+)?$ list-page.php/$0 [L]
